<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Waxd terminal/ops-console theme. Same four hex values as every other
        waxd reskin (see waxd-launcher's colors.xml) so a palette revision can
        be copied across the whole suite. Applied via explicit Material3 color
        roles in themes.xml, since this app (unlike the Fossify forks) doesn't
        have a shared "commons" library with resource-merge overrides.
    -->
    <color name="waxd_background">#0A0C0A</color>
    <color name="waxd_text">#D8F5E0</color>
    <color name="waxd_primary">#2E9E5B</color>
    <color name="waxd_accent">#4CFF8B</color>

    <color name="system_accent1_100">#cbe2ff</color>

    <color name="system_neutral1_100">#dde2e9</color>
    <color name="system_neutral1_900">#181c1f</color>

    <color name="unselected_option_bg">#2d3034</color>
    <color name="appbar">#77000000</color>

    <color name="self_illumination_light">#ffe8cf</color>

    <color name="z_yellow">#ffdf00</color>

    <color name="qr_result_background">#E1E3E5</color>

    <color name="red">#ff0000</color>
</resources>
